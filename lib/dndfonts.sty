\msg_new:nnn { dnd } { fonts / needs_unicode_engine }
  {
    The~"fonts=#1"~option~uses~OpenType~fonts~and~needs~XeLaTeX~or~
    LuaLaTeX.~Compile~with~xelatex~or~lualatex~instead~of~pdflatex.
  }

\msg_new:nnn { dnd } { fonts / solbera_missing }
  {
    Solbera's~fonts~were~not~found~in~"#1".~Run~bin/get-solbera-fonts~
    to~download~them,~or~set~the~"fontpath"~class~option~to~the~folder~
    that~holds~them.
  }

% Typeset the character with code #1 as #2 (XeTeX with 8-bit fonts)
\cs_new_protected:Npn \__dnd_xetex_t1_char:nN #1#2
  {
    \char_set_active_eq:nN {#1} #2
    \char_set_catcode_active:n {#1}
  }

% #1 - family variable, #2 - base file name, #3 - extra fontspec options
\cs_new_protected:Npn \__dnd_solbera_family:Nnn #1#2#3
  {
    \newfontfamily #1 {#2}
      [ Path = \l__dnd_font_path_tl , Extension = .otf , #3 ]
  }

\cs_new_protected:Npn \__dnd_load_solbera_fonts:
  {
    % Look the folder up like any input file, so a book in a subfolder finds
    % the template's fonts/solbera/ through \input@path or TEXINPUTS
    \file_get_full_name:nNTF { \l__dnd_font_path_tl Bookinsanity.otf } \l_tmpa_str
      {
        \tl_set:NV \l__dnd_font_path_tl \l_tmpa_str
        \regex_replace_once:nnN { Bookinsanity\.otf \Z } { } \l__dnd_font_path_tl
      }
      { \msg_fatal:nnV { dnd } { fonts / solbera_missing } \l__dnd_font_path_tl }
    \setmainfont {Bookinsanity}
      [
        Path           = \l__dnd_font_path_tl ,
        Extension      = .otf ,
        UprightFont    = * ,
        BoldFont       = *~Bold ,
        ItalicFont     = *~Italic ,
        BoldItalicFont = *~Bold~Italic ,
        SmallCapsFont  = Mr~Eaves~Small~Caps ,
      ]
    \setsansfont {Scaly~Sans}
      [
        Path           = \l__dnd_font_path_tl ,
        Extension      = .otf ,
        UprightFont    = * ,
        BoldFont       = *~Bold ,
        ItalicFont     = *~Italic ,
        BoldItalicFont = *~Bold~Italic ,
        SmallCapsFont  = Scaly~Sans~Caps ,
        BoldFeatures   = { SmallCapsFont = Scaly~Sans~Caps~Bold } ,
      ]
    % Mr Eaves only has small caps, so every shape maps to it; bold is faked
    % for stat block titles.
    \__dnd_solbera_family:Nnn \sctitlefont {Mr~Eaves~Small~Caps}
      {
        SmallCapsFont = * ,
        BoldFont      = * ,
        BoldFeatures  = { FakeBold = 1.5 } ,
      }
    \__dnd_solbera_family:Nnn \booktitlefont {Nodesto~Caps~Condensed}
      {
        BoldFont       = NodestoCapsCondensed-Bold ,
        ItalicFont     = NodestoCapsCondensed-Italic ,
        BoldItalicFont = NodestoCapsCondensed-Bold~Italic ,
        SmallCapsFont  = * ,
      }
    \__dnd_solbera_family:Nnn \quotefont {Zatanna~Misdirection}
      {
        BoldFont       = *~Bold ,
        ItalicFont     = *~Italic ,
        BoldItalicFont = *~Bold~Italic ,
      }
    \__dnd_solbera_family:Nnn \dropcapfont {Solbera~Imitation} {}
  }

\bool_if:NT \l__dnd_layout_bool
  {
    \tl_case:NnF \l__dnd_fontset_tl
      {
        \l__dnd_fontset_solbera_tl
          {
            \sys_if_engine_pdftex:T
              { \msg_fatal:nnn { dnd } { fonts / needs_unicode_engine } {solbera} }
            \RequirePackage{fontspec}
            \__dnd_load_solbera_fonts:
          }
        \l__dnd_fontset_wotc_tl
          {
            \RequirePackage{fontspec}
            \RequirePackage{xltxtra}
            \RequirePackage{xunicode}
            \setromanfont[Mapping=tex-text]{Bookmania}
            \setsansfont[Scale=MatchLowercase,Mapping=tex-text,Numbers=Lining]{Scala~Sans~OT}
            \newfontfamily{\sctitlefont}[Mapping=tex-text,Scale=MatchLowercase]{Mrs~Eaves~Small~Caps~OT}
            \newfontfamily{\booktitlefont}[Mapping=tex-text]{Nodesto~Caps~Condensed}
            \newfontfamily{\quotefont}[Mapping=tex-text]{DaiVernon Misdirect}
          }
        \l__dnd_fontset_dmsguild_tl
          {
            \RequirePackage{fontspec}
            \RequirePackage{xltxtra}
            \RequirePackage{xunicode}
            \setromanfont[Mapping=tex-text]{TeX~Gyre~Bonum}
            \setsansfont[Scale=MatchLowercase,Mapping=tex-text,Numbers=Lining,AutoFakeSlant=0.2]{Junction}
            \newfontfamily{\sctitlefont}[Mapping=tex-text,Scale=MatchLowercase]{Andada~SC}
            \newcommand{\booktitlefont}{\sctitlefont}
            \newfontfamily{\quotefont}[Mapping=tex-text]{Zatanna Misdirection}
          }
      }
      {
        \RequirePackage{bookman}
        \RequirePackage[type1]{gillius2}
        \RequirePackage[notext,nomath,nott]{kpfonts}
        \RequirePackage[T1]{fontenc}
        % The default fonts are 8-bit Type 1 fonts. LuaTeX would otherwise
        % send Unicode code points straight to T1 slots, so that e.g. "ß"
        % (U+00DF) prints the "SS" glyph that T1 keeps at that position.
        \sys_if_engine_luatex:T
          { \RequirePackage[utf8]{luainputenc} }
        % XeTeX does the same. Latin-1 letters happen to match their T1
        % slots, so map the characters that do not: "ß" and the punctuation
        % above U+00FF, which T1 has in other slots.
        \sys_if_engine_xetex:T
          {
            \clist_map_inline:nn
              {
                { "00DF } \ss, { "0152 } \OE, { "0153 } \oe,
                { "2018 } \textquoteleft, { "2019 } \textquoteright,
                { "201A } \quotesinglbase, { "201C } \textquotedblleft,
                { "201D } \textquotedblright, { "201E } \quotedblbase,
                { "00AB } \guillemotleft, { "00BB } \guillemotright,
                { "2013 } \textendash, { "2014 } \textemdash,
                { "2026 } \textellipsis
              }
              { \__dnd_xetex_t1_char:nN #1 }
          }
        \renewcommand{\sfdefault}{jkpss}
        \newcommand{\booktitlefont}{\normalfont}
        \newcommand{\sctitlefont}{\normalfont}
        \newcommand{\quotefont}{\sffamily}
        % URW Chancery, a Zapf Chancery clone in every TeX distribution
        \newcommand{\handwritingfont}{\fontfamily{pzc}\selectfont}
      }
  }

% Font sets without their own drop cap face use Royal
\cs_if_exist:NF \dropcapfont
  { \cs_new_protected:Npn \dropcapfont { \Royal } }

% Handwriting for letters and notes: the font set's quotation face
% (Zatanna Misdirection with Solbera's fonts)
\cs_if_exist:NF \handwritingfont
  {
    \cs_new_protected:Npn \handwritingfont
      { \cs_if_exist:NTF \quotefont { \quotefont } { \itshape } }
  }

\cs_new_protected:Npn \__dnd_sf_initial_family:
  {
    \bool_if:NTF \l__dnd_layout_bool
      {
        \tl_case:NnTF \l__dnd_fontset_tl
          {
            \l__dnd_fontset_wotc_tl {}
            \l__dnd_fontset_dmsguild_tl {}
            \l__dnd_fontset_solbera_tl {}
          }
          { \sffamily }
          { \gilliustwo }
      }
      { \sffamily }
  }

\cs_new_protected:Npn \__dnd_page_num_style:
  {
    \bool_if:NTF \l__dnd_eberron_mode_bool
      {\large \textcolor{titlered}}
      {\scriptsize \textcolor{pagegold}}
  }

\cs_new_protected:Npn \__dnd_footer_style:
  {
    \bool_if:NTF \l__dnd_eberron_mode_bool
      {\scriptsize \textcolor{titlered}}
      {\scriptsize \textcolor{pagegold}}
  }

% A font size as a multiple of the current size, e.g. \DndRelativeSize{1.3}
% for 13pt headings in a 10pt book. Heading sizes are measured from the
% 2014 core books; see docs/typography.md.
\NewDocumentCommand {\DndRelativeSize} { m }
  {
    \fontsize
      { \fp_eval:n { round ( #1 * \f@size , 2 ) } pt }
      { \fp_eval:n { round ( #1 * \f@size , 2 ) } pt }
    \selectfont
  }

