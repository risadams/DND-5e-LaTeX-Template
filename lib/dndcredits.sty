\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Credits and legal page
%
% \DndCreditsPage[<options>]{<credits>} sets a page of credits, then the legal
% notices at the foot of the page: the SRD attribution for the `srd` class
% option, a credit for the fonts of the active font set, and anything given
% to \DndLegalText or \DndCreditsLogo.
%
%   \DndCredit{<role>}{<names>}  one line of credits; <role> is a keyword
%                                (design, writing, ...) or any text
%   \DndCreditsHeading{<text>}   a heading between groups of credits
%   \DndLegalText{<text>}        a paragraph of legal text (e.g. DMsGuild's)
%   \DndCreditsLogo[<height>]{<file>}  a logo in the row under the legal text
%
%   \DndSRDAttribution[<language>] the SRD attribution statement on its own
%   \DndFontCredits                the font credit on its own
%   \DndIfSRD{<version>}{<true>}{<false>}  text for one SRD version only
%   \DndSRDVersion                 the SRD version of this build
%
% This is not legal advice. Check the sources given with each statement.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage {url}
\RequirePackage {multicol}

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% SRD version (class option `srd`)
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% True when the build uses SRD #1. A shorter version matches every release
% under it: 5.2 matches 5.2 and 5.2.1.
\prg_new_conditional:Npnn \__dnd_if_srd:n #1 { p, T, F, TF }
  {
    \bool_lazy_or:nnTF
      { \str_if_eq_p:Vn \l__dnd_srd_tl {#1} }
      {
        \str_if_eq_p:ee
          { \str_range:Nnn \l__dnd_srd_tl { 1 } { \str_count:n {#1} + 1 } }
          { #1 . }
      }
      { \prg_return_true: }
      { \prg_return_false: }
  }

\NewExpandableDocumentCommand \DndIfSRD { m m m }
  { \__dnd_if_srd:nTF {#1} {#2} {#3} }

\NewExpandableDocumentCommand \DndSRDVersion { }
  { \str_if_eq:VnF \l__dnd_srd_tl { none } { \tl_use:N \l__dnd_srd_tl } }

