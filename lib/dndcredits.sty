% Statement language for a babel or polyglossia language name
% #1 - language name
\cs_new:Npn \__dnd_srd_language:n #1
  {
    \str_case_e:nnF {#1}
      {
        { german }        { german }
        { ngerman }       { german }
        { austrian }      { german }
        { naustrian }     { german }
        { swissgerman }   { german }
        { nswissgerman }  { german }
        { spanish }       { spanish }
        { french }        { french }
        { francais }      { french }
        { acadian }       { french }
        { canadien }      { french }
        { italian }       { italian }
      }
      { english }
  }

\msg_new:nnn { dnd } { credits / srd_language }
  {
    There~is~no~"#2"~SRD~#1~attribution~statement.~
    Using~the~English~statement.
  }

% #1 - language: auto (the document language) or english, german, spanish,
%      french, italian
\cs_new_protected:Npn \__dnd_srd_attribution:n #1
  {
    \str_if_eq:VnF \l__dnd_srd_tl { none }
      {
        \tl_set:Ne \l__dnd_tmp_tl
          {
            \str_if_eq:nnTF {#1} { auto }
              {
                \cs_if_exist:NTF \languagename
                  { \__dnd_srd_language:n { \languagename } }
                  { english }
              }
              {#1}
          }
        \cs_if_exist:cF { c__dnd_srd_ \l__dnd_srd_tl _ \l__dnd_tmp_tl _tl }
          {
            \str_if_eq:nnF {#1} { auto }
              {
                \msg_warning:nnVV { dnd } { credits / srd_language }
                  \l__dnd_srd_tl \l__dnd_tmp_tl
              }
            \tl_set:Nn \l__dnd_tmp_tl { english }
          }
        \tl_use:c { c__dnd_srd_ \l__dnd_srd_tl _ \l__dnd_tmp_tl _tl }
      }
  }
\tl_new:N \l__dnd_tmp_tl

\NewDocumentCommand \DndSRDAttribution { O{auto} }
  { \__dnd_srd_attribution:n {#1} }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Font credits
%
% Solbera's fonts are licensed CC BY-SA 4.0, which asks for the creators, the
% license with a link to it, and a link to the material (section 3(a)(1)).
% The font package sets no wording of its own; this credit gives all three.
% Sources, checked 2026-09-27:
%   https://github.com/jonathonf/solbera-dnd-fonts/tree/v1.5 (README, LICENSE)
%   https://creativecommons.org/licenses/by-sa/4.0/legalcode
%
% fonts=dmsguild and fonts=wotc also use one of Solbera's fonts each. The other
% fonts the template uses (TeX Gyre Bonum, Andada, Junction, Bookman, Gillius,
% Kp-Fonts, Royal, and URW Chancery for handouts with the default fonts) do
% not ask for a credit in the document.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Solbera's fonts in use, or nothing
\cs_new:Npn \__dnd_solbera_fonts_used:
  {
    \bool_if:NT \l__dnd_layout_bool
      {
        \str_case:VnF \l__dnd_fontset_tl
          {
            { solbera }
              {
                Bookinsanity,~Mr~Eaves~Small~Caps,~Nodesto~Caps~Condensed,~
                Scaly~Sans,~Scaly~Sans~Caps,~Solbera~Imitation,~
                Zatanna~Misdirection
              }
            { dmsguild } { Zatanna~Misdirection }
            { wotc }     { Nodesto~Caps~Condensed }
          }
          { }
      }
  }

\cs_new_protected:Npn \__dnd_font_credits:
  {
    \tl_set:Ne \l__dnd_tmp_tl { \__dnd_solbera_fonts_used: }
    \tl_if_empty:NF \l__dnd_tmp_tl
      {
        \textbf { \fontscreditname : } ~
        \exp_args:NnV \__dnd_caption:nn { \fontcreditname } \l__dnd_tmp_tl
        \c_space_tl
        \url { https://github.com/jonathonf/solbera-dnd-fonts } . ~
        \fontlicensename \c_space_tl
        \url { https://creativecommons.org/licenses/by-sa/4.0/ } .
      }
  }

\NewDocumentCommand \DndFontCredits { } { \__dnd_font_credits: }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Credits
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Role keywords and the captions they print
\prop_const_from_keyval:Nn \c__dnd_credit_roles_prop
  {
    design        = \designcreditname ,
    development   = \developmentcreditname ,
    writing       = \writingcreditname ,
    editing       = \editingcreditname ,
    art-direction = \artdirectioncreditname ,
    cover-art     = \coverartcreditname ,
    interior-art  = \interiorartcreditname ,
    cartography   = \cartographycreditname ,
    layout        = \layoutcreditname ,
    playtesting   = \playtestingcreditname ,
    thanks        = \thankscreditname ,
    fonts         = \fontscreditname ,
  }

% #1 - role keyword or text, #2 - names
\NewDocumentCommand \DndCredit { m m }
  {
    \par
    \group_begin:
    % Keep each credit in one column
    \interlinepenalty = 10000
    \hangindent = 1em
    \hangafter = 1
    \noindent
    \textbf
      {
        \prop_get:NnNTF \c__dnd_credit_roles_prop {#1} \l__dnd_tmp_tl
          { \tl_use:N \l__dnd_tmp_tl }
          {#1}
        :
      } ~
    #2
    \par
    \group_end:
  }

\NewDocumentCommand \DndCreditsHeading { m }
  {
    \par
    \addvspace { 1ex }
    \noindent
    { \DndFontSubsection #1 }
    \par
    \nopagebreak
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Legal text and logos
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \g__dnd_credits_legal_tl
\tl_new:N \g__dnd_credits_logos_tl

% Paragraphs printed under the SRD and font credits by the next
% \DndCreditsPage. Use it in the preamble or in the page's credits.
\NewDocumentCommand \DndLegalText { +m }
  { \tl_gput_right:Nn \g__dnd_credits_legal_tl { \par #1 \par } }

\NewDocumentCommand \DndCreditsLogo { O{.5in} m }
  {
    \tl_gput_right:Nn \g__dnd_credits_logos_tl
      { \includegraphics [ height = #1 ] {#2} \hfil }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Page
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\tl_new:N \l__dnd_credits_title_tl
\int_new:N \l__dnd_credits_columns_int
\bool_new:N \l__dnd_credits_fonts_bool
\tl_new:N \l__dnd_credits_srd_language_tl
\tl_new:N \l__dnd_credits_pagestyle_tl

\keys_define:nn { dnd / credits }
  {
    title .tl_set:N          = \l__dnd_credits_title_tl,
    title .initial:n         = \creditsname,
    columns .int_set:N       = \l__dnd_credits_columns_int,
    columns .initial:n       = 2,
    fonts .choice:,
    fonts / auto .code:n     = \bool_set_true:N \l__dnd_credits_fonts_bool,
    fonts / none .code:n     = \bool_set_false:N \l__dnd_credits_fonts_bool,
    fonts .initial:n         = auto,
    srd-language .tl_set:N   = \l__dnd_credits_srd_language_tl,
    srd-language .initial:n  = auto,
    pagestyle .tl_set:N      = \l__dnd_credits_pagestyle_tl,
    pagestyle .initial:n     = empty,
  }

\cs_new_protected:Npn \__dnd_credits_legal:
  {
    \str_if_eq:VnF \l__dnd_srd_tl { none }
      { \par \__dnd_srd_attribution:V \l__dnd_credits_srd_language_tl \par }
    \bool_if:NT \l__dnd_credits_fonts_bool
      { \par \__dnd_font_credits: \par }
    \tl_use:N \g__dnd_credits_legal_tl
    \tl_gclear:N \g__dnd_credits_legal_tl
    \tl_if_empty:NF \g__dnd_credits_logos_tl
      {
        \par \addvspace { 1ex }
        \hbox_to_wd:nn { \linewidth } { \hfil \g__dnd_credits_logos_tl }
        \tl_gclear:N \g__dnd_credits_logos_tl
      }
  }
\cs_generate_variant:Nn \__dnd_srd_attribution:n { V }

\bool_new:N \l__dnd_credits_twocolumn_bool

% #1 - options, #2 - credits
\NewDocumentCommand \DndCreditsPage { O{} +m }
  {
    % The page is one column wide. \onecolumn and \twocolumn set the column
    % layout globally, so switch outside the group.
    \bool_set:Nn \l__dnd_credits_twocolumn_bool
      { \legacy_if_p:n { @twocolumn } }
    \bool_if:NTF \l__dnd_credits_twocolumn_bool { \onecolumn } { \clearpage }
    \group_begin:
      \keys_set:nn { dnd / credits } {#1}
      \exp_args:NV \thispagestyle \l__dnd_credits_pagestyle_tl
      \tl_if_empty:NF \l__dnd_credits_title_tl
        {
          \__dnd_pdf_bookmark:nn
            { \cs_if_exist:NTF \chapter { 0 } { 1 } }
            { \l__dnd_credits_title_tl }
          \noindent
          { \DndFontSection \l__dnd_credits_title_tl }
          \par \nopagebreak \medskip
        }
      \group_begin:
        \small
        \int_compare:nNnTF \l__dnd_credits_columns_int > 1
          {
            \setlength { \columnsep } { .33in }
            \raggedcolumns
            \begin{multicols} { \l__dnd_credits_columns_int }
              #2
            \end{multicols}
          }
          { #2 \par }
      \group_end:
      \vfill
      \group_begin:
        \scriptsize
        \urlstyle { same }
        \setlength { \parindent } { 0pt }
        \setlength { \parskip } { .6ex }
        \__dnd_credits_legal:
      \group_end:
    \group_end:
    \clearpage
    \bool_if:NT \l__dnd_credits_twocolumn_bool { \twocolumn }
  }
