\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Print production
%
% With bleed=<dim>, the paper size set by the class (letterpaper, a4paper,
% ...) becomes the trim size: the physical page grows by the bleed on every
% side and the text layout stays on the trimmed page. Backgrounds and
% full-bleed images fill the whole physical page. Each PDF page gets a
% TrimBox and BleedBox so print services know where to cut.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\RequirePackage {eso-pic}

\dim_new:N \l__dnd_trim_width_dim
\dim_new:N \l__dnd_trim_height_dim
\dim_set:Nn \l__dnd_trim_width_dim  { \paperwidth }
\dim_set:Nn \l__dnd_trim_height_dim { \paperheight }

% Trimmed width of the whole sheet: one page, or with the cover option a
% cover spread (back cover, spine, front cover)
\dim_new:N \l__dnd_sheet_width_dim
\bool_if:NTF \l__dnd_cover_bool
  { \dim_set:Nn \l__dnd_sheet_width_dim { 2 \l__dnd_trim_width_dim + \l__dnd_spine_dim } }
  { \dim_set_eq:NN \l__dnd_sheet_width_dim \l__dnd_trim_width_dim }

% True when the physical sheet differs from the trimmed page
\bool_new:N \l__dnd_print_sheet_bool
\bool_set:Nn \l__dnd_print_sheet_bool
  { \l__dnd_cover_bool || \dim_compare_p:nNn { \l__dnd_bleed_dim } > { 0pt } }

% Bleed width, for positioning page furniture from the paper edge
\NewExpandableDocumentCommand {\DndBleed} {} { \dim_use:N \l__dnd_bleed_dim }

\bool_if:NT \l__dnd_layout_bool
  {
    \bool_if:NT \l__dnd_print_sheet_bool
      {
        \geometry
          {
            paperwidth    = \dim_eval:n { \l__dnd_sheet_width_dim  + 2 \l__dnd_bleed_dim },
            paperheight   = \dim_eval:n { \l__dnd_trim_height_dim + 2 \l__dnd_bleed_dim },
            layoutwidth   = \l__dnd_sheet_width_dim,
            layoutheight  = \l__dnd_trim_height_dim,
            layouthoffset = \l__dnd_bleed_dim,
            layoutvoffset = \l__dnd_bleed_dim,
          }
      }

    \bool_if:NT \l__dnd_cropmarks_bool
      { \geometry { showcrop } }
  }

% PDF page boxes, in big points
\tl_new:N \l__dnd_trim_box_tl
\tl_new:N \l__dnd_bleed_box_tl
\tl_new:N \l__dnd_page_boxes_tl
\tl_set:Ne \l__dnd_trim_box_tl
  {
    [
      \dim_to_decimal_in_bp:n { \l__dnd_bleed_dim } ~
      \dim_to_decimal_in_bp:n { \l__dnd_bleed_dim } ~
      \dim_to_decimal_in_bp:n { \l__dnd_sheet_width_dim  + \l__dnd_bleed_dim } ~
      \dim_to_decimal_in_bp:n { \l__dnd_trim_height_dim + \l__dnd_bleed_dim }
    ]
  }
\tl_set:Ne \l__dnd_bleed_box_tl
  {
    [ 0 ~ 0 ~
      \dim_to_decimal_in_bp:n { \l__dnd_sheet_width_dim  + 2 \l__dnd_bleed_dim } ~
      \dim_to_decimal_in_bp:n { \l__dnd_trim_height_dim + 2 \l__dnd_bleed_dim }
    ]
  }
\tl_set:Ne \l__dnd_page_boxes_tl
  { /TrimBox ~ \l__dnd_trim_box_tl \c_space_tl /BleedBox ~ \l__dnd_bleed_box_tl }

\bool_if:NT \l__dnd_print_sheet_bool
  {
    \AddToHook { begindocument / end }
      {
        \IfPDFManagementActiveTF
          {
            \AddToHook { shipout / before }
              {
                \exp_args:NnnV \pdfmanagement_add:nnn { ThisPage } { TrimBox }
                  \l__dnd_trim_box_tl
                \exp_args:NnnV \pdfmanagement_add:nnn { ThisPage } { BleedBox }
                  \l__dnd_bleed_box_tl
              }
          }
          {
            \sys_if_engine_xetex:TF
              {
                \AddToShipoutPictureFG
                  { \special { pdf:put ~ @thispage ~ << \l__dnd_page_boxes_tl >> } }
              }
              {
                \sys_if_engine_luatex:TF
                  {
                    \use:e
                      {
                        \exp_not:N \tex_pdfvariable:D pageattr
                          {
                            \tex_the:D \tex_pdfvariable:D pageattr
                            \c_space_tl \l__dnd_page_boxes_tl
                          }
                      }
                  }
                  {
                    \use:e
                      {
                        \exp_not:N \tex_pdfpageattr:D
                          {
                            \tex_the:D \tex_pdfpageattr:D
                            \c_space_tl \l__dnd_page_boxes_tl
                          }
                      }
                  }
              }
          }
      }
  }

