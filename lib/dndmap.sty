\ExplSyntaxOn

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Maps
%
% \begin{DndMap}[caption=Cragmaw Hideout, label=cragmaw, scale=1 square = 5 feet,
%                compass=0, placement=wide]{maps/cragmaw}
%   \DndMapArea{0.42,0.61}{Cave Mouth}      % prints the number \DndArea gave it
%   \DndMapSubArea{0.30,0.20}{Twin Pools}
%   \DndMapText{0.80,0.10}{To Phandalin}    % shown on every version
%   \DndMapText*{0.55,0.75}{Secret door}    % DM map only
% \end{DndMap}
%
% Positions are fractions of the image: (0,0) is the bottom-left corner and
% (1,1) the top-right. Add `coordinates` to overlay a grid for finding them.
% Area numbers come from \DndArea/\DndSubArea, so the map follows any
% renumbering. \DndPlayerMap{cragmaw} prints the same map without the DM-only
% labels, and \DndMapRef{cragmaw} gives "Map 1.1".
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Sideways maps: pdflscape also turns the page upright in PDF viewers
\RequirePackage {pdflscape}

% Maps are numbered within chapters when there are chapters
\newcounter {DndMap}
\cs_if_exist:cT { c@chapter } { \counterwithin {DndMap} {chapter} }

\tl_new:N \l__dnd_map_caption_tl
\tl_new:N \l__dnd_map_label_tl
\tl_new:N \l__dnd_map_placement_tl
\tl_new:N \l__dnd_map_float_tl
\tl_new:N \l__dnd_map_scale_tl
\tl_new:N \l__dnd_map_compass_tl
\bool_new:N \l__dnd_map_labels_bool
\bool_new:N \l__dnd_map_coordinates_bool
\bool_new:N \l__dnd_map_player_bool
\bool_new:N \l__dnd_map_appendix_bool
\bool_new:N \l__dnd_map_twocolumn_bool
\tl_new:N \l__dnd_map_file_tl
\tl_new:N \l__dnd_map_body_tl

\prop_new:N \g__dnd_map_file_prop
\prop_new:N \g__dnd_map_body_prop
\prop_new:N \g__dnd_map_options_prop

\msg_new:nnn { dnd } { map / unknown }
  { No~map~with~label~"#1"~has~been~defined~yet.~Put~\token_to_str:N \DndPlayerMap \c_space_tl after~its~DndMap. }

\keys_define:nn { dnd / map }
  {
    caption .tl_set:N = \l__dnd_map_caption_tl,
    label .tl_set:N   = \l__dnd_map_label_tl,
    placement .choices:nn = { column, wide, page, sideways }
      { \tl_set_eq:NN \l__dnd_map_placement_tl \l_keys_choice_tl },
    placement .initial:n  = column,
    float .choices:nn = { t, b, h, p }
      { \tl_set_eq:NN \l__dnd_map_float_tl \l_keys_choice_tl },
    scale .tl_set:N   = \l__dnd_map_scale_tl,
    compass .tl_set:N = \l__dnd_map_compass_tl,
    compass .default:n = 0,
    labels .bool_set:N = \l__dnd_map_labels_bool,
    labels .initial:n  = true,
    coordinates .bool_set:N = \l__dnd_map_coordinates_bool,
    coordinates .default:n  = true,
    % \DndPlayerMap only: add the map to the handout appendix instead
    appendix .bool_set:N = \l__dnd_map_appendix_bool,
    appendix .default:n  = true,
  }

% Document-wide defaults, e.g. \DndSetMapOptions[labels=false] for a
% player's edition
\NewDocumentCommand {\DndSetMapOptions} { m }
  { \keys_set:nn { dnd / map } {#1} }

% Styles; override with e.g. \tikzset{dnd map label/.append style={fill=yellow}}
\tikzset
  {
    dnd~map~label/.style =
      {
        circle , fill = white , draw = black , line~width = .8pt ,
        inner~sep = 1pt , minimum~size = 1.7em ,
        font = \sffamily \bfseries \small ,
      },
    dnd~map~text/.style =
      {
        fill = white , fill~opacity = .8 , text~opacity = 1 ,
        inner~sep = 2pt , rounded~corners = 2pt ,
        font = \sffamily \bfseries \footnotesize ,
      },
    dnd~map~scale/.style =
      { dnd~map~text , font = \sffamily \itshape \footnotesize },
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Labels, for use inside DndMap
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% #1 - label text, #2 - position, #3 - style
\cs_new_protected:Npn \__dnd_map_node:nnn #1#2#3
  { \node [ #3 ] at ( #2 ) {#1}; }

% \DndMapArea[<area options, e.g. region=B>]{x,y}{area label}
\NewDocumentCommand {\DndMapArea} { o m m }
  {
    \bool_if:NT \l__dnd_map_labels_bool
      {
        \__dnd_map_node:nnn
          { \IfNoValueTF {#1} { \DndAreaRef* {#3} } { \DndAreaRef* [#1] {#3} } }
          {#2} { dnd~map~label }
      }
  }

% \DndMapSubArea[<area options>]{x,y}{sub-area label}
\NewDocumentCommand {\DndMapSubArea} { o m m }
  {
    \bool_if:NT \l__dnd_map_labels_bool
      {
        \__dnd_map_node:nnn
          { \IfNoValueTF {#1} { \DndSubAreaRef* {#3} } { \DndSubAreaRef* [#1] {#3} } }
          {#2} { dnd~map~label }
      }
  }

% \DndMapText[<tikz style>]{x,y}{text}; the starred form is DM-only
\NewDocumentCommand {\DndMapText} { s O{} m m }
  {
    \bool_lazy_or:nnT { !#1 } { \l__dnd_map_labels_bool }
      { \__dnd_map_node:nnn {#4} {#3} { dnd~map~text , #2 } }
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% Drawing
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% Grid with 0.1 steps to read off label positions
\cs_new_protected:Npn \__dnd_map_coordinates:
  {
    \bool_if:NT \l__dnd_map_coordinates_bool
      {
        \int_step_inline:nnn { 1 } { 9 }
          {
            \draw [ red , opacity = .6 , very~thin ]
              ( \fp_eval:n { ##1 / 10 } , 0 ) -- ( \fp_eval:n { ##1 / 10 } , 1 );
            \draw [ red , opacity = .6 , very~thin ]
              ( 0 , \fp_eval:n { ##1 / 10 } ) -- ( 1 , \fp_eval:n { ##1 / 10 } );
            \node [ red , font = \tiny \sffamily , anchor = south , fill = white , inner~sep = 1pt ]
              at ( \fp_eval:n { ##1 / 10 } , 0 ) { .##1 };
            \node [ red , font = \tiny \sffamily , anchor = west , fill = white , inner~sep = 1pt ]
              at ( 0 , \fp_eval:n { ##1 / 10 } ) { .##1 };
          }
      }
  }

\cs_new_protected:Npn \__dnd_map_compass:
  {
    \tl_if_empty:NF \l__dnd_map_compass_tl
      {
        \begin {scope} [ shift = { ( .92 , .88 ) } ]
          \begin {scope} [ x = 1cm , y = 1cm ]
            \fill [ white , opacity = .8 ] ( 0 , 0 ) circle ( .6 );
            \draw [ line~width = .6pt ] ( 0 , 0 ) circle ( .6 );
            \begin {scope} [ rotate = \l__dnd_map_compass_tl ]
              \fill ( 0 , .25 ) -- ( -.13 , -.3 ) -- ( 0 , -.18 ) -- ( .13 , -.3 ) -- cycle;
              \node [ font = \sffamily \bfseries \small , inner~sep = 0pt ]
                at ( 0 , .42 ) { N };
            \end {scope}
          \end {scope}
        \end {scope}
      }
  }

% #1 - file, #2 - body (labels), #3 - includegraphics size options
\cs_new_protected:Npn \__dnd_map_picture:nnn #1#2#3
  {
    \begin {tikzpicture}
      \node [ anchor = south~west , inner~sep = 0pt ] ( dndmap ) at ( 0 , 0 )
        { \__dnd_art_graphics:nn {#3} {#1} };
      \begin {scope} [ x = { ( dndmap.south~east ) } , y = { ( dndmap.north~west ) } ]
        \__dnd_map_coordinates:
        #2
        \tl_if_empty:NF \l__dnd_map_scale_tl
          {
            \node [ dnd~map~scale , anchor = south~west ] at ( .02 , .02 )
              { \l__dnd_map_scale_tl };
          }
        \__dnd_map_compass:
      \end {scope}
    \end {tikzpicture}
  }

\cs_generate_variant:Nn \__dnd_map_picture:nnn { VVe }

% Numbered maps step the counter, get a label and a list-of-maps entry; player
% maps are unnumbered. Used in vertical mode above the picture, so that links
% to the map show the map rather than its caption.
\cs_new_protected:Npn \__dnd_map_number:
  {
    \bool_if:NF \l__dnd_map_player_bool
      {
        \refstepcounter {DndMap}
        \tl_if_empty:NF \l__dnd_map_label_tl
          { \exp_args:Ne \label { map: \l__dnd_map_label_tl } }
        \addcontentsline {lom} {dndmap}
          {
            \protect \numberline { \theDndMap }
            \exp_not:V \l__dnd_map_caption_tl
          }
      }
  }

% Caption below the map
\cs_new_protected:Npn \__dnd_map_caption:
  {
    \par \nopagebreak \vspace { 3pt } \noindent
    \bool_if:NTF \l__dnd_map_player_bool
      {
        { \DndFontTableTitle \playermapname
          \tl_if_empty:NF \l__dnd_map_caption_tl { : ~ \l__dnd_map_caption_tl } }
      }
      {
        { \DndFontTableTitle \mapname \nobreakspace \theDndMap
          \tl_if_empty:NF \l__dnd_map_caption_tl { : ~ \l__dnd_map_caption_tl } }
      }
    \par
  }

% #1 - file, #2 - body
\cs_new_protected:Npn \__dnd_map_place:nn #1#2
  {
    \str_case:Vn \l__dnd_map_placement_tl
      {
        { column }
          {
            \tl_if_empty:NTF \l__dnd_map_float_tl
              {
                \par \addvspace { 9pt plus 3pt minus 3pt }
                \__dnd_map_number: \noindent
                \__dnd_map_picture:nnn {#1} {#2} { width = \linewidth }
                \__dnd_map_caption:
                \addvspace { 9pt plus 3pt minus 3pt }
              }
              {
                \use:e { \exp_not:N \begin {figure} [ \l__dnd_map_float_tl ] }
                  \__dnd_map_number: \noindent
                  \__dnd_map_picture:nnn {#1} {#2} { width = \linewidth }
                  \__dnd_map_caption:
                \end {figure}
              }
          }
        { wide }
          {
            \use:e
              {
                \exp_not:N \begin {figure*}
                  [ \tl_if_empty:NTF \l__dnd_map_float_tl { t } { \l__dnd_map_float_tl } ]
              }
              \__dnd_map_number: \noindent
              \__dnd_map_picture:nnn {#1} {#2} { width = \textwidth }
              \__dnd_map_caption:
            \end {figure*}
          }
        { page }
          {
            \begin {figure*} [p]
              \centering
              \__dnd_map_number:
              \__dnd_map_picture:nnn {#1} {#2}
                {
                  width = \textwidth ,
                  height = \dim_eval:n { \textheight - 4 \baselineskip } ,
                  keepaspectratio
                }
              \__dnd_map_caption:
            \end {figure*}
          }
        { sideways }
          {
            \__dnd_map_sideways:n
              {
                \centering
                \__dnd_map_number:
                \__dnd_map_picture:nnn {#1} {#2}
                  {
                    width = \linewidth ,
                    height = \dim_eval:n { \textheight - 4 \baselineskip } ,
                    keepaspectratio
                  }
                \__dnd_map_caption:
              }
          }
      }
  }

% A page of its own, turned sideways; the text stops at the end of the
% current page. #1 - content
\cs_new_protected:Npn \__dnd_map_sideways:n #1
  {
    \bool_set:Nn \l__dnd_map_twocolumn_bool { \legacy_if_p:n { @twocolumn } }
    \bool_if:NTF \l__dnd_map_twocolumn_bool { \onecolumn } { \clearpage }
    \begin {landscape}
      #1
    \end {landscape}
    \bool_if:NT \l__dnd_map_twocolumn_bool { \twocolumn }
  }
\cs_generate_variant:Nn \str_case:nn { V }

% \begin{DndMap}[<options>]{<image>} <labels> \end{DndMap}
\NewDocumentEnvironment {DndMap} { O{} m +b }
  {
    \group_begin:
      \bool_set_false:N \l__dnd_map_player_bool
      \keys_set:nn { dnd / map } {#1}
      \tl_if_empty:NF \l__dnd_map_label_tl
        {
          \prop_gput:NVn \g__dnd_map_file_prop \l__dnd_map_label_tl {#2}
          \prop_gput:NVn \g__dnd_map_body_prop \l__dnd_map_label_tl {#3}
          \prop_gput:NVn \g__dnd_map_options_prop \l__dnd_map_label_tl {#1}
        }
      \__dnd_map_place:nn {#2} {#3}
    \group_end:
  }
  {}

% Set up the player version of map #1 with extra options #2: the map's own
% options, no DM labels, unnumbered. Its image and labels go in
% \l__dnd_map_file_tl and \l__dnd_map_body_tl.
\cs_new_protected:Npn \__dnd_player_map_setup:nn #1#2
  {
    \prop_get:NnN \g__dnd_map_options_prop {#1} \l_tmpa_tl
    \exp_args:Nno \keys_set:nn { dnd / map } { \l_tmpa_tl }
    \keys_set:nn { dnd / map }
      { label = {} , labels = false , appendix = false , #2 }
    \bool_set_true:N \l__dnd_map_player_bool
    \prop_get:NnN \g__dnd_map_file_prop {#1} \l__dnd_map_file_tl
    \prop_get:NnN \g__dnd_map_body_prop {#1} \l__dnd_map_body_tl
  }

% The same map for players: no area numbers or DM-only text, unnumbered.
% With `appendix`, it becomes a numbered handout in \DndHandoutAppendix
% instead, referred to as \DndHandoutRef{<map label>}.
% \DndPlayerMap[<options, e.g. placement=page or appendix>]{<map label>}
\NewDocumentCommand {\DndPlayerMap} { O{} m }
  {
    \prop_if_in:NnTF \g__dnd_map_file_prop {#2}
      {
        \group_begin:
          \__dnd_player_map_setup:nn {#2} {#1}
          \bool_if:NTF \l__dnd_map_appendix_bool
            {
              \__dnd_handout_next_number:
              \__dnd_handout_list_entry:VV
                \l__dnd_handout_number_tl \l__dnd_map_caption_tl
              \use:e
                {
                  \__dnd_handout_queue:n
                    {
                      \exp_not:N \__dnd_map_handout_page:nnn
                        { \l__dnd_handout_number_tl }
                        { \exp_not:n {#2} }
                        { \exp_not:n {#1} }
                    }
                }
            }
            { \exp_args:NVV \__dnd_map_place:nn \l__dnd_map_file_tl \l__dnd_map_body_tl }
        \group_end:
      }
      { \msg_error:nnn { dnd } { map / unknown } {#2} }
  }

% A player map as a page of the handout appendix, turned sideways if its
% placement is sideways. #1 - handout number, #2 - map label, #3 - options
\cs_new_protected:Npn \__dnd_map_handout_page:nnn #1#2#3
  {
    \group_begin:
      \__dnd_player_map_setup:nn {#2} {#3}
      \str_if_eq:VnTF \l__dnd_map_placement_tl { sideways }
        {
          \bool_gset_false:N \g__dnd_handout_first_page_bool
          \begin {landscape}
            \__dnd_map_handout_content:nn {#1} {#2}
          \end {landscape}
        }
        { \__dnd_map_handout_content:nn {#1} {#2} }
    \group_end:
  }

% Heading and map, filling the rest of the page
\cs_new_protected:Npn \__dnd_map_handout_content:nn #1#2
  {
    \__dnd_handout_heading:nnV {#1} {#2} \l__dnd_map_caption_tl
    \vfill
    \centering
    \__dnd_map_picture:VVe \l__dnd_map_file_tl \l__dnd_map_body_tl
      {
        width = \dim_use:N \linewidth ,
        height = \dim_eval:n { \textheight - 5 \baselineskip } ,
        keepaspectratio
      }
    \par
    \vfill
  }

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% References and the list of maps
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% \DndMapRef{label} gives "Map 1.1"; \DndMapRef*{label} gives "1.1"
\NewDocumentCommand {\DndMapRef} { s m }
  {
    \IfBooleanTF {#1}
      { \ref { map:#2 } }
      { \mapname \nobreakspace \ref { map:#2 } }
  }

\cs_new:cpn { l@dndmap } { \@dottedtocline {1} {0em} {2.3em} }

% \DndListOfMaps[<sectioning command>] (default \section*)
\NewDocumentCommand {\DndListOfMaps} { O{\section*} }
  {
    #1 { \listmapsname }
    % Starred headings have no bookmark; add one at the heading's level
    \__dnd_pdf_bookmark:nn
      {
        \str_case:nnF {#1}
          {
            { \part* }       { -1 }
            { \chapter* }    { 0 }
            { \subsection* } { 2 }
          }
          { 1 }
      }
      { \listmapsname }
    \@starttoc {lom}
  }
